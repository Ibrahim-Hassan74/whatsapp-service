# ─── Server ───────────────────────────────────────────────────────
# Application environment: "development" or "production"
NODE_ENV=production

# Port the HTTP server listens on
PORT=5000

# Logging level: error, warn, info, http, debug
LOG_LEVEL=info

# ─── ASP.NET Backend Integration ─────────────────────────────────
# Base URL of your ASP.NET backend (no trailing slash)
ASP_NET_BASE_URL=http://your-aspnet-backend-url

# Shared secret token for authenticating requests between services
NODE_TOKEN=your-secure-shared-token-here

# Identifier for this WhatsApp service instance
SERVER_NAME=NODE_WHATSAPP_SERVICE

# ─── WhatsApp / Puppeteer ────────────────────────────────────────
# Directory to store WhatsApp session data
# In Docker, mount a volume to this path for session persistence
SESSION_DATA_PATH=./sessions

# Path to Chromium/Chrome binary (auto-detected if not set)
# Docker:   /usr/bin/chromium  (set automatically)
# Windows:  Auto-detected from Program Files
# macOS:    Auto-detected from /Applications
# CHROMIUM_PATH=/usr/bin/chromium

# ─── Reconnection Tuning (optional) ─────────────────────────────
# Max reconnection attempts before giving up (default: 5)
# MAX_RETRIES=5

# Heartbeat interval in ms to check WhatsApp connection (default: 30000)
# HEARTBEAT_INTERVAL_MS=30000
